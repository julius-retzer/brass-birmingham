{
  "name": "brass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "node scripts/vercel-migrate.mjs && next build",
    "check": "biome check && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:local": "docker compose up -d --wait",
    "db:local:down": "docker compose down",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node scripts/guarded-push.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "lint": "biome lint",
    "lint:fix": "biome check --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "test": "vitest run src/store/gameStore.*.test.ts src/data/*.test.ts src/components/*.test.ts src/components/mp/*.test.ts src/server/ai/*.test.ts src/server/db/*.test.ts src/server/mp/*.test.ts scripts/*.test.ts",
    "test:watch": "vitest src/store/gameStore.*.test.ts src/data/*.test.ts src/components/*.test.ts src/components/mp/*.test.ts src/server/ai/*.test.ts src/server/db/*.test.ts src/server/mp/*.test.ts scripts/*.test.ts",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@libsql/client": "^0.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "@xstate/react": "^6.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwindcss-animate": "^1.0.7",
    "xstate": "^5.32.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@neondatabase/api-client": "^2.7.3",
    "@playwright/test": "^1.61.1",
    "@statelyai/inspect": "^0.7.2",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^3.4.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^3.2.7"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "pnpm@10.4.1"
}
